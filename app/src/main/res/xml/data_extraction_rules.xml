<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include essential user settings if any, but currently we have none in files -->

        <!-- Exclude large transient or sensitive data -->
        <exclude domain="file" path="files/embeddings/" />
        <exclude domain="file" path="files/logs/" />
        <exclude domain="file" path="rag_crash.log" />
        <exclude domain="file" path="ai_chat_history.json" />
        <exclude domain="file" path="search_history.json" />

        <!-- Skip local database to avoid proprietary knowledge leakage and quota issues -->
        <exclude domain="database" path="powerai.db" />
        <exclude domain="database" path="powerai.db-shm" />
        <exclude domain="database" path="powerai.db-wal" />

        <!-- Skip shared preferences if they contain API keys or sensitive session data -->
        <exclude domain="sharedpref" path="com.example.powerai_preferences.xml" />
    </cloud-backup>

    <device-transfer>
        <!-- For device transfer, we can be slightly more lenient but still exclude large binaries -->
        <exclude domain="file" path="files/embeddings/" />

        <!-- Keep database for device transfer to provide seamless transition if permitted by security policy -->
        <!-- But per "总方向重构.md", knowledge should not be unexpectedly backed up -->
        <exclude domain="database" path="powerai.db" />
        <exclude domain="database" path="powerai.db-shm" />
        <exclude domain="database" path="powerai.db-wal" />

        <exclude domain="sharedpref" path="com.example.powerai_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
